module

public import Mathlib.LinearAlgebra.TensorAlgebra.Basic

/-!
# Weyl algebras

We construct the Weyl algebra of a module `M` over a commutative ring `R`, equipped with a
bilinear form `B`: the `R`-algebra generated by `M` subject to the relations
`m * n - n * m = B m n`. For the standard symplectic form on `R²ⁿ` this is the classical Weyl
algebra `Aₙ(R)`; over a field of characteristic zero, `Aₙ(R)` is isomorphic to the ring of
differential operators on the polynomial ring in `n` variables (this is not proved here).

## Main definitions

* `WeylAlgebra B`: the Weyl algebra of the bilinear form `B`, an `R`-algebra.
* `WeylAlgebra.ι B : M →ₗ[R] WeylAlgebra B`: the canonical linear map.
* `WeylAlgebra.lift B`: the universal property. A linear map `f : M →ₗ[R] A` into an `R`-algebra
  `A` with `f m * f n = f n * f m + algebraMap R A (B m n)` for all `m n` lifts uniquely to an
  `R`-algebra morphism `WeylAlgebra B →ₐ[R] A`.

## Main statements

* `WeylAlgebra.ι_mul_ι_comm`: the defining relation
  `ι m * ι n = ι n * ι m + algebraMap R _ (B m n)`.
* `WeylAlgebra.ι_comp_lift`, `WeylAlgebra.lift_unique`: `lift B f` extends `f`, and is the unique
  such morphism.
* `WeylAlgebra.algebraMap_apply_self`, `WeylAlgebra.algebraMap_apply_swap`: in `WeylAlgebra B`,
  the relations force `algebraMap R _ (B m m) = 0` and
  `algebraMap R _ (B n m) = -algebraMap R _ (B m n)`; the identities `B m m = 0` and
  `B n m = -B m n` need not hold in `R`.
* `WeylAlgebra.subsingleton_of_isUnit_apply_self`: if some `B m m` is a unit in `R`, then
  `WeylAlgebra B` is the zero ring.

## Implementation notes

The Weyl algebra is the quotient of `TensorAlgebra R M` by the ring congruence generated by
`WeylAlgebra.Rel B`, which identifies `ι m * ι n` with `ι n * ι m + algebraMap R _ (B m n)`.
As for `UniversalEnvelopingAlgebra.Rel`, the relation, and hence the condition in
`WeylAlgebra.lift`, is stated without subtraction; as for `CliffordAlgebra.lift`, this lets
`WeylAlgebra.lift` accept any `Semiring` as target.

No assumption is made on `B`. Taking `m = n` in the relation shows that the image of `B m m`
under `algebraMap R (WeylAlgebra B)` vanishes, and comparing the relations for `(m, n)` and
`(n, m)` shows that the image of `B n m` is the negative of the image of `B m n`. These
identities hold in the Weyl algebra; the corresponding identities in `R` need not hold. The
classical Weyl algebras come from alternating forms; if `B` is not alternating, the quotient may
degenerate. For example, the form `B x y = x * y` on `ZMod 2` is symmetric and also
skew-symmetric, but `B 1 1 = 1`, so its Weyl algebra is the zero ring. In particular `ι B` need
not be injective and `WeylAlgebra B` need not be nontrivial; such results need hypotheses on `B`.

This file is modelled on `Mathlib/LinearAlgebra/CliffordAlgebra/Basic.lean`, with the relation
`ι m * ι m = algebraMap R _ (Q m)` replaced by the commutation relation above. Defining the Weyl
algebra of an arbitrary bilinear form as a quotient of the tensor algebra follows a suggestion by
Eric Wieser on
[Zulip](https://leanprover.zulipchat.com/#narrow/channel/116395-maths/topic/Formalising.20Weyl.20Algebras.20.2F.20D-Modules/near/567806630).

## References

* [S. C. Coutinho, *A primer of algebraic D-modules*][coutinho1995]

## Tags

Weyl algebra, canonical commutation relations, bilinear form
-/

@[expose] public section

variable {R : Type*} [CommRing R]
variable {M : Type*} [AddCommGroup M] [Module R M]
variable (B : LinearMap.BilinForm R M)

namespace WeylAlgebra

open TensorAlgebra

/-- `Rel` relates each `ι m * ι n`, for `m n : M`, with `ι n * ι m + algebraMap R _ (B m n)`.

The Weyl algebra of `M` is defined as the quotient modulo this relation. -/
inductive Rel : TensorAlgebra R M → TensorAlgebra R M → Prop
  | of (m n : M) : Rel (ι R m * ι R n) (ι R n * ι R m + algebraMap R _ (B m n))

/-- The ring congruence generated by `Rel B`, used to build the quotient. -/
@[no_expose] def ringCon : RingCon (TensorAlgebra R M) := ringConGen (Rel B)

end WeylAlgebra

/-- The Weyl algebra of an `R`-module `M` equipped with a bilinear form `B`. -/
@[wikidata Q1069378]
def WeylAlgebra := WeylAlgebra.ringCon B |>.Quotient
deriving Inhabited

namespace WeylAlgebra

-- This instance exists to avoid nsmul and zsmul diamonds.
instance {R A M} [CommSemiring R] [AddCommGroup M] [CommRing A]
    [Algebra R A] [Module R M] [Module A M] (B : LinearMap.BilinForm A M)
    [IsScalarTower R A M] : SMul R (WeylAlgebra B) :=
  inferInstanceAs <| SMul R (RingCon.Quotient _)

deriving instance Ring for WeylAlgebra

instance (priority := 900) instAlgebra' {R A M} [CommSemiring R] [AddCommGroup M] [CommRing A]
    [Algebra R A] [Module R M] [Module A M] (B : LinearMap.BilinForm A M)
    [IsScalarTower R A M] :
    Algebra R (WeylAlgebra B) :=
  inferInstanceAs <| Algebra R (RingCon.Quotient _)

instance : Algebra R (WeylAlgebra B) := inferInstance

-- verify there are no diamonds
-- but doesn't work at `reducible_and_instances` https://github.com/leanprover-community/mathlib4/issues/10906
example : (Semiring.toNatAlgebra : Algebra ℕ (WeylAlgebra B)) = instAlgebra' _ := rfl
-- but doesn't work at `reducible_and_instances` https://github.com/leanprover-community/mathlib4/issues/10906
example : (Ring.toIntAlgebra _ : Algebra ℤ (WeylAlgebra B)) = instAlgebra' _ := rfl

instance {R S A M} [CommSemiring R] [CommSemiring S] [AddCommGroup M] [CommRing A]
    [Algebra R A] [Algebra S A] [Module R M] [Module S M] [Module A M]
    (B : LinearMap.BilinForm A M) [IsScalarTower R A M] [IsScalarTower S A M] :
    SMulCommClass R S (WeylAlgebra B) :=
  RingCon.instSMulCommClassQuotient _

instance {R S A M} [CommSemiring R] [CommSemiring S] [AddCommGroup M] [CommRing A]
    [SMul R S] [Algebra R A] [Algebra S A] [Module R M] [Module S M] [Module A M]
    [IsScalarTower R A M] [IsScalarTower S A M] [IsScalarTower R S A]
    (B : LinearMap.BilinForm A M) :
    IsScalarTower R S (WeylAlgebra B) :=
  RingCon.instIsScalarTowerQuotient _

/-- The canonical linear map `M →ₗ[R] WeylAlgebra B`.

This map need not be injective: see the implementation notes in the module docstring. -/
def ι : M →ₗ[R] WeylAlgebra B :=
  (RingCon.mkₐ R _).toLinearMap.comp (TensorAlgebra.ι R)

/-- The defining relation of the Weyl algebra. -/
theorem ι_mul_ι_comm (m n : M) : ι B m * ι B n = ι B n * ι B m + algebraMap R _ (B m n) :=
  Quotient.sound <| RingCon.le_ringConGen _ _ (Rel.of m n)

/-- The commutator of two generators is a scalar. -/
@[simp]
theorem ι_mul_ι_sub_swap (m n : M) :
    ι B m * ι B n - ι B n * ι B m = algebraMap R _ (B m n) := by
  rw [ι_mul_ι_comm, add_sub_cancel_left]

/-- `ι_mul_ι_sub_swap` stated with the ring commutator `⁅x, y⁆ = x * y - y * x`. -/
@[simp]
theorem ι_lie_ι (m n : M) : ⁅ι B m, ι B n⁆ = algebraMap R _ (B m n) := by
  rw [Ring.lie_def, ι_mul_ι_sub_swap]

/-- The relation for `m = n` forces the image of `B m m` in `WeylAlgebra B` to vanish. -/
@[simp]
theorem algebraMap_apply_self (m : M) : algebraMap R (WeylAlgebra B) (B m m) = 0 := by
  simpa using (ι_mul_ι_sub_swap B m m).symm

/-- Comparing the relations for `(m, n)` and `(n, m)` shows that the image of `B n m` in
`WeylAlgebra B` is the negative of the image of `B m n`. -/
theorem algebraMap_apply_swap (m n : M) :
    algebraMap R (WeylAlgebra B) (B n m) = -algebraMap R (WeylAlgebra B) (B m n) := by
  rw [← ι_mul_ι_sub_swap, ← ι_mul_ι_sub_swap, neg_sub]

variable {B} in
/-- If some `B m m` is a unit in `R`, then `WeylAlgebra B` is the zero ring. This happens for
instance for the form `B x y = x * y` on `ZMod 2`. -/
theorem subsingleton_of_isUnit_apply_self {m : M} (h : IsUnit (B m m)) :
    Subsingleton (WeylAlgebra B) := by
  have := h.map (algebraMap R (WeylAlgebra B))
  rw [algebraMap_apply_self, isUnit_zero_iff] at this
  exact subsingleton_of_zero_eq_one this

variable {B} {A : Type*} [Semiring A] [Algebra R A]

theorem comp_ι_mul_ι_comm (g : WeylAlgebra B →ₐ[R] A) (m n : M) :
    g (ι B m) * g (ι B n) = g (ι B n) * g (ι B m) + algebraMap _ _ (B m n) := by
  rw [← map_mul g, ← map_mul g, ι_mul_ι_comm, map_add, AlgHom.commutes]

set_option backward.isDefEq.respectTransparency.types false in
variable (B) in
/-- Given a linear map `f : M →ₗ[R] A` into an `R`-algebra `A` which satisfies
`cond : ∀ m n, f m * f n = f n * f m + algebraMap _ _ (B m n)`, this is the canonical lift of `f`
to a morphism of `R`-algebras from `WeylAlgebra B` to `A`. -/
@[simps symm_apply]
def lift :
    { f : M →ₗ[R] A // ∀ m n, f m * f n = f n * f m + algebraMap _ _ (B m n) } ≃
      (WeylAlgebra B →ₐ[R] A) where
  toFun f :=
    RingCon.liftₐ (WeylAlgebra.ringCon B)
      (TensorAlgebra.lift R (f : M →ₗ[R] A))
      (by
        exact RingCon.ringConGen_le.2 fun x y (h : Rel B x y) => by
          induction h with | of m n
          simpa using f.prop m n)
  invFun F :=
    ⟨F.toLinearMap.comp (ι B), fun m n => by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply]
      exact comp_ι_mul_ι_comm F m n⟩
  left_inv f := by
    ext x
    dsimp
    exact (RingCon.liftₐ_mk _ _ _ _).trans (TensorAlgebra.lift_ι_apply _ x)
  right_inv F :=
    RingCon.Quotient.hom_extₐ <|
      TensorAlgebra.hom_ext <|
        LinearMap.ext fun x ↦ by
          dsimp
          exact (RingCon.liftₐ_mk _ _ _ _).trans (TensorAlgebra.lift_ι_apply _ _)

@[simp]
theorem ι_comp_lift (f : M →ₗ[R] A)
    (cond : ∀ m n, f m * f n = f n * f m + algebraMap _ _ (B m n)) :
    (lift B ⟨f, cond⟩).toLinearMap.comp (ι B) = f :=
  Subtype.mk_eq_mk.mp <| (lift B).symm_apply_apply ⟨f, cond⟩

@[simp]
theorem lift_ι_apply (f : M →ₗ[R] A)
    (cond : ∀ m n, f m * f n = f n * f m + algebraMap _ _ (B m n)) (x) :
    lift B ⟨f, cond⟩ (ι B x) = f x :=
  (LinearMap.ext_iff.mp <| ι_comp_lift f cond) x

-- not `@[simp]`: the `simpNF` linter reaches the maximum recursion depth on it
theorem lift_unique (f : M →ₗ[R] A)
    (cond : ∀ m n, f m * f n = f n * f m + algebraMap _ _ (B m n))
    (g : WeylAlgebra B →ₐ[R] A) : g.toLinearMap.comp (ι B) = f ↔ g = lift B ⟨f, cond⟩ := by
  convert (lift B : _ ≃ (WeylAlgebra B →ₐ[R] A)).symm_apply_eq
  rw [lift_symm_apply, Subtype.mk_eq_mk]

@[simp]
theorem lift_comp_ι (g : WeylAlgebra B →ₐ[R] A) :
    lift B ⟨g.toLinearMap.comp (ι B), comp_ι_mul_ι_comm _⟩ = g :=
  (lift B : _ ≃ (WeylAlgebra B →ₐ[R] A)).apply_symm_apply g

/-- See note [partially-applied ext lemmas]. -/
@[ext high]
theorem hom_ext {A : Type*} [Semiring A] [Algebra R A] {f g : WeylAlgebra B →ₐ[R] A} :
    f.toLinearMap.comp (ι B) = g.toLinearMap.comp (ι B) → f = g := by
  intro h
  apply (lift B).symm.injective
  rw [lift_symm_apply, lift_symm_apply]
  simp only [h]

/-- If `motive` holds for the `algebraMap` of `r : R` into `WeylAlgebra B`, the `ι` of `x : M`,
and is preserved under addition and multiplication, then it holds for all of `WeylAlgebra B`. -/
@[elab_as_elim]
theorem induction {motive : WeylAlgebra B → Prop}
    (algebraMap : ∀ r, motive (algebraMap R (WeylAlgebra B) r)) (ι : ∀ x, motive (ι B x))
    (mul : ∀ a b, motive a → motive b → motive (a * b))
    (add : ∀ a b, motive a → motive b → motive (a + b))
    (a : WeylAlgebra B) : motive a := by
  obtain ⟨a, rfl⟩ := RingCon.mkₐ_surjective (α := R) _ a
  induction a using TensorAlgebra.induction with
  | algebraMap r => rw [AlgHom.commutes]; exact algebraMap r
  | ι x => exact ι x
  | mul x y hx hy => rw [map_mul]; exact mul _ _ hx hy
  | add x y hx hy => rw [map_add]; exact add _ _ hx hy

@[simp]
theorem adjoin_range_ι : Algebra.adjoin R (Set.range (ι B)) = ⊤ := by
  refine top_unique fun x hx => ?_; clear hx
  induction x using induction with
  | algebraMap => exact algebraMap_mem _ _
  | add x y hx hy => exact add_mem hx hy
  | mul x y hx hy => exact mul_mem hx hy
  | ι x => exact Algebra.subset_adjoin (Set.mem_range_self _)

@[simp]
theorem range_lift (f : M →ₗ[R] A)
    (cond : ∀ m n, f m * f n = f n * f m + algebraMap _ _ (B m n)) :
    (lift B ⟨f, cond⟩).range = Algebra.adjoin R (Set.range f) := by
  simp_rw [← Algebra.map_top, ← adjoin_range_ι, AlgHom.map_adjoin, ← Set.range_comp,
    Function.comp_def, lift_ι_apply]

@[simp]
theorem ι_range_map_lift (f : M →ₗ[R] A)
    (cond : ∀ m n, f m * f n = f n * f m + algebraMap _ _ (B m n)) :
    (LinearMap.range (ι B)).map (lift B ⟨f, cond⟩).toLinearMap = LinearMap.range f := by
  rw [← LinearMap.range_comp, ι_comp_lift]

end WeylAlgebra

namespace TensorAlgebra

variable {B}

/-- The canonical image of the `TensorAlgebra` in the `WeylAlgebra`, which maps
`TensorAlgebra.ι R x` to `WeylAlgebra.ι B x`. -/
def toWeyl : TensorAlgebra R M →ₐ[R] WeylAlgebra B :=
  TensorAlgebra.lift R (WeylAlgebra.ι B)

@[simp]
theorem toWeyl_ι (m : M) : toWeyl (TensorAlgebra.ι R m) = WeylAlgebra.ι B m := by
  simp [toWeyl]

end TensorAlgebra
